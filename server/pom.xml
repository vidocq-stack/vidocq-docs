<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.vidocq.docs</groupId>
  <artifactId>vidocq-docs-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Vidocq docs — Chappe launcher</name>
  <description>
    Launcher Java minimal qui sert le site Antora via Chappe.
    Tant que Chappe n'a pas de mode CLI standalone, ce module joue le rôle.
  </description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <chappe.version>0.1.0-SNAPSHOT</chappe.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.vidocq.chappe</groupId>
      <artifactId>chappe-api</artifactId>
      <version>${chappe.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vidocq.chappe</groupId>
      <artifactId>chappe-core</artifactId>
      <version>${chappe.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.vidocq.chappe</groupId>
      <artifactId>chappe-http</artifactId>
      <version>${chappe.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.vidocq.docs.ChappeDocsServer</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
