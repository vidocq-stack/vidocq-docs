# Copier en .env (ou coller dans le formulaire "Environment variables" de la
# stack Portainer). Chaque variable a un défaut raisonnable dans le compose ;
# l'override est utile pour pinner une version, ou pour tester un tag custom.

# ─── Image ────────────────────────────────────────────────────────────
# Staging : "snapshot" (mutable, écrasé à chaque push main par le workflow Forgejo)
# Prod    : "latest"   (mutable, écrasé à chaque tag v* par le workflow Forgejo)
# Pour pinner une version :  IMAGE_TAG=0.1.0
IMAGE_TAG=snapshot

# Nom DNS interne du container Chappe. Le sidecar OIDC sera ${CONTAINER_NAME}-oauth.
# Mettre une valeur unique par stack si tu déploies staging et prod sur le même hôte.
CONTAINER_NAME=vidocq-docs-staging

# ─── OIDC (oauth2-proxy en sidecar) ───────────────────────────────────
# Créer une OAuth2 Application côté Forgejo :
#   User Settings → Applications → OAuth2 Applications → Create
#     Name         : vidocq-docs-staging (ou -prod selon la stack)
#     Redirect URI : https://staging-doc.vidocq.dev/oauth2/callback
#                    (ou https://doc.vidocq.dev/oauth2/callback pour prod)
#     Confidential : yes
# Forgejo retourne Client ID + Client Secret.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Cookie secret pour oauth2-proxy. Générer avec :
#   openssl rand -base64 32
OIDC_COOKIE_SECRET=
