# Stack Kroki — copier en .env (ou coller dans Portainer → Stack → Environment).
# Tous les défauts sont déjà bons pour Vidocq. Override uniquement si besoin.

# ─── Image ────────────────────────────────────────────────────────────
# Voir releases : https://github.com/yuzutech/kroki/releases
# 0.27.1 = release stable (fin 2025), inclut PlantUML 1.2025.x.
KROKI_TAG=0.27.1

# ─── Limite de taille requête ─────────────────────────────────────────
# asciidoctor-kroki encode le source du diagramme en base64 dans l'URL GET.
# Pour des diagrammes volumineux (gros séquence, gros C4), augmenter.
# 16384 = 16 KiB, suffisant pour les diagrammes Vidocq actuels.
# Max recommandé : 65536. Au-delà, le NPM peut tronquer (cf. directive
# `large_client_header_buffers` côté Nginx).
KROKI_MAX_URI_LEN=16384
