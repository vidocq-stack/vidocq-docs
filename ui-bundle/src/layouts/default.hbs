<!DOCTYPE html>
<html lang="en" data-theme="auto">
  {{> head}}
  <body class="article{{#if page.home}} is-home{{/if}}">
    <div class="body">
      {{> header}}
      <main>
        <aside class="nav">
          {{> nav}}
        </aside>
        <article class="doc">
          {{{page.contents}}}
        </article>
      </main>
      {{> footer}}
    </div>
    <script src="{{{uiRootPath}}}/js/site.js"></script>
    {{#if env.SITE_SEARCH_PROVIDER}}{{> search-scripts}}{{/if}}
  </body>
</html>
