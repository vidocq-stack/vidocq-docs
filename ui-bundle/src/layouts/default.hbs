<!DOCTYPE html>
<html lang="en" data-theme="auto">
  {{> head}}
  <body class="article{{#if page.home}} is-home{{/if}}">
    <div class="body">
      {{> header}}
      <main>
        <aside class="nav">
          <details class="docs-navigation" open>
            <summary>Documentation menu</summary>
            {{> nav}}
          </details>
        </aside>
        <article class="doc">
          <h1>{{{page.title}}}</h1>
          {{{page.contents}}}
        </article>
      </main>
      {{> footer}}
    </div>
    <script src="{{{uiRootPath}}}/js/site.js{{#if env.GITHUB_SHA}}?v={{env.GITHUB_SHA}}{{/if}}"></script>
    {{#if env.SITE_SEARCH_PROVIDER}}{{> search-scripts}}{{/if}}
  </body>
</html>
