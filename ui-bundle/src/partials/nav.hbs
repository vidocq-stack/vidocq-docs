{{#if page.componentVersion}}
  <h3>{{page.componentVersion.title}}</h3>
{{/if}}
{{#each page.navigation}}
  <ul>
    {{#each items}}
      <li>
        {{#if url}}
          <a href="{{relativize url}}"{{#if (eq url ../../page.url)}} class="is-current-page"{{/if}}>{{{content}}}</a>
        {{else}}
          <span>{{{content}}}</span>
        {{/if}}
        {{#if items}}
          <ul>
            {{#each items}}
              <li>
                {{#if url}}
                  <a href="{{relativize url}}"{{#if (eq url ../../../../page.url)}} class="is-current-page"{{/if}}>{{{content}}}</a>
                {{else}}
                  <span>{{{content}}}</span>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        {{/if}}
      </li>
    {{/each}}
  </ul>
{{/each}}
