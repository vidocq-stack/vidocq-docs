{{> components-quick-nav}}

{{#if page.componentVersion}}
  <h3 class="component-nav-title">{{page.componentVersion.title}}</h3>
{{/if}}
{{#if page.versions}}
  <select class="component-version-selector" aria-label="{{i18n 'version'}}">
    {{#each page.versions}}
      <option value="{{relativize url}}"{{#if (eq version ../page.componentVersion.version)}} selected{{/if}}>{{displayVersion}}</option>
    {{/each}}
  </select>
{{/if}}
{{#each page.navigation}}
  <ul>
    {{#each items}}
      <li{{#if items}} class="nav-group"{{/if}}>
        {{#if items}}
          <details class="nav-group-details">
            <summary class="nav-group-summary">
              {{#if url}}
                <a href="{{relativize url}}"{{#if (eq url ../../page.url)}} class="is-current-page"{{/if}}>{{{content}}}</a>
              {{else}}
                <span>{{{content}}}</span>
              {{/if}}
            </summary>
            <ul>
              {{#each items}}
                <li>
                  {{#if url}}
                    <a href="{{relativize url}}"{{#if (eq url ../../../page.url)}} class="is-current-page"{{/if}}>{{{content}}}</a>
                  {{else}}
                    <span>{{{content}}}</span>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          </details>
        {{else}}
          {{#if url}}
            <a href="{{relativize url}}"{{#if (eq url ../../page.url)}} class="is-current-page"{{/if}}>{{{content}}}</a>
          {{else}}
            <span>{{{content}}}</span>
          {{/if}}
        {{/if}}
      </li>
    {{/each}}
  </ul>
{{/each}}
