<nav class="pagination" aria-label="pagination">
  {{#if page.previous}}
    <a rel="prev" href="{{relativize page.previous.url}}">← {{i18n 'previous'}} : {{page.previous.title}}</a>
  {{/if}}
  {{#if page.next}}
    <a rel="next" href="{{relativize page.next.url}}">{{i18n 'next'}} : {{page.next.title}} →</a>
  {{/if}}
</nav>
