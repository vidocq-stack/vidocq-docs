{{#if page.versions.[1]}}
<nav class="toolbar" aria-label="version">
  <div class="toolbar-inner">
    {{#if page.componentVersion}}
      <span class="toolbar-component">{{page.componentVersion.title}}</span>
    {{/if}}
    <label class="toolbar-version-label" for="version-selector">{{i18n 'version'}}</label>
    <select id="version-selector" class="component-version-selector" aria-label="{{i18n 'version'}}">
      {{#each page.versions}}
        <option value="{{relativize url}}"{{#if (eq version ../page.componentVersion.version)}} selected{{/if}}>{{displayVersion}}</option>
      {{/each}}
    </select>
  </div>
</nav>
{{/if}}
