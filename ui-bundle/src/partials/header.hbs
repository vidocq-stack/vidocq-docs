<header class="navbar">
  <div class="navbar-inner">
    <a class="navbar-brand" href="{{{site.url}}}/" aria-label="{{site.title}}">
      <svg class="monogram" width="28" height="28" viewBox="0 0 64 64" aria-hidden="true">
        <path d="M10 12 L32 56 L54 12 M16 12 L32 50 L48 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="32" cy="9" r="1.6" fill="currentColor"/>
      </svg>
      <span>{{site.title}}</span>
    </a>
    <div class="navbar-tools">
      {{> language-toggle}}
      <button type="button" class="theme-toggle" aria-label="{{i18n 'toggle-theme'}}" title="{{i18n 'toggle-theme'}}">☼ ☾</button>
    </div>
  </div>
</header>
