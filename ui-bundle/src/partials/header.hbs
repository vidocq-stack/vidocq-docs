<header class="navbar">
  <div class="navbar-inner">
    <a class="navbar-brand" href="https://vidocq.dev" aria-label="{{site.title}}">
      <img class="navbar-logo" src="{{{uiRootPath}}}/img/vidocq-logo.png" width="36" height="36" alt="" aria-hidden="true">
      <span class="navbar-title">{{site.title}}</span>
      <span class="navbar-section">Documentation</span>
    </a>
    <div class="navbar-tools">
      {{#if (version-options)}}
      <div class="version-switch" title="{{i18n 'version'}}">
        <span class="version-switch-label">{{i18n 'version'}}</span>
        <select class="component-version-selector" aria-label="{{i18n 'version'}}"
                data-site-versions='{{site-versions-json}}'{{#unless page.componentVersion.version}} data-context-switch{{/unless}}>
          {{#each (version-options)}}
            <option value="{{version}}"{{#if url}} data-url="{{relativize url}}"{{/if}}{{#if selected}} selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      {{/if}}
      {{#if env.SITE_SEARCH_PROVIDER}}
      <div class="search-box">
        <input id="search-input" type="search" placeholder="{{i18n 'search'}}" aria-label="{{i18n 'search'}}" autocomplete="off">
      </div>
      {{/if}}
      <button type="button" class="theme-toggle" aria-label="{{i18n 'toggle-theme'}}" title="{{i18n 'toggle-theme'}}">☼ ☾</button>
    </div>
  </div>
</header>
